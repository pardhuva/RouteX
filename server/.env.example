# RouteX Backend Configuration

# Server Port & Environment
PORT=5050
NODE_ENV=production

# Database Connection (Replace with your MongoDB Atlas or local connection string)
# Example for MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/routex?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/ride-hailing

# Authentication & Security
# Generate a strong secret (e.g. openssl rand -base64 32)
JWT_SECRET=your_secure_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (e.g. http://localhost:5173 or https://your-frontend-domain.com)
CORS_ORIGIN=http://localhost:5173

# Initial Platform Administrator Credentials (Auto-provisioned on startup if no admin exists)
ADMIN_EMAIL=admin@routex.io
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=RouteX Executive Admin
ADMIN_PHONE=9999999999

# Geospatial Proximity Radius (50 km = 50000 meters)
DRIVER_SEARCH_RADIUS_METERS=50000

# Redis Cache (Optional - System automatically falls back to in-memory TTL if offline)
REDIS_URL=redis://localhost:6379
REDIS_DRIVER_TTL_SECONDS=30
REDIS_RIDE_LOCATION_TTL_SECONDS=120

# Apache Kafka (Optional - System automatically falls back to EventEmitter if offline)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=routex-backend

# Fare Estimation Formula: Base (₹50) + ₹15/km + ₹2/min
FARE_BASE=50
FARE_PER_KM=15
FARE_PER_MINUTE=2
PAYMENT_CURRENCY=INR
